{
  "name": "granum-grid-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "granum-grid",
    "packages/*",
    "demo"
  ],
  "scripts": {
    "dev": "npm run dev -w demo",
    "media:dev": "vite --config media/vite.config.ts",
    "media:build": "tsc -p media/tsconfig.json && vite build --config media/vite.config.ts",
    "media:screenshots": "node media/scripts/capture.mjs screenshots",
    "media:video": "node media/scripts/capture.mjs video",
    "media:all": "node media/scripts/capture.mjs all",
    "build": "npm run build -w granum-grid && npm run build -w packages/parquet -w packages/sql && npm run build -w demo",
    "ai:doctor": "node scripts/ai-doctor.mjs",
    "record:trace": "node scripts/record-demo-trace.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "check": "npm run typecheck && npm run test:tutorials && npm test",
    "check:full": "npm run format:check && npm run release:check && npm run media:build && npm run test:e2e && npm run test:pages",
    "test": "vitest run",
    "test:tutorials": "node scripts/check-tutorials.mjs",
    "lint": "eslint granum-grid/src packages/*/src demo/src media/src",
    "test:smoke": "playwright test demo/tests/acceptance.spec.ts --project=chromium",
    "test:e2e": "playwright test",
    "test:pages": "node scripts/pages-smoke.mjs",
    "test:perf": "playwright test demo/tests/performance.spec.ts",
    "test:package": "node scripts/package-test.mjs && node scripts/size.mjs",
    "release:check": "npm run lint && npm run check && npm run build && npm run test:package",
    "format": "npm run format:check -- --write",
    "format:check": "prettier --check granum-grid/src granum-grid/tests packages/*/src packages/*/tests demo/src demo/tests demo/unit demo/server demo/vite.config.ts media/src media/scripts media/vite.config.ts scripts playwright.config.ts vitest.config.ts eslint.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "eslint": "^10.12.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.1.0",
    "vitest": "^5.0.4"
  }
}
