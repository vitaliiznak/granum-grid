{
  "name": "@granum/core",
  "version": "0.1.0",
  "description": "Framework-free navigation, data sessions, native scrolling, and map primitives for exploring enormous indexed datasets",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitaliiznak/granum-grid.git",
    "directory": "packages/core"
  },
  "homepage": "https://vitaliiznak.github.io/granum-grid/",
  "bugs": "https://github.com/vitaliiznak/granum-grid/issues",
  "keywords": [
    "virtualization",
    "virtual-scroll",
    "large-datasets",
    "data-exploration",
    "framework-agnostic"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./dist/dom/index.js"
    },
    "./map": {
      "types": "./dist/map/index.d.ts",
      "import": "./dist/map/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./base.css": "./dist/base.css",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 104",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ]
}
