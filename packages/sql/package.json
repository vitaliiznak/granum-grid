{
  "name": "@granum-grid/sql",
  "version": "0.1.0",
  "description": "Rows, exact maps, and complete search from SQL (DuckDB's dialect) as a Granum Grid data provider",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitaliiznak/granum-grid.git",
    "directory": "packages/sql"
  },
  "homepage": "https://vitaliiznak.github.io/granum-grid/",
  "bugs": "https://github.com/vitaliiznak/granum-grid/issues",
  "keywords": [
    "duckdb",
    "duckdb-wasm",
    "sql",
    "large-datasets",
    "data-exploration"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@granum-grid/core": "^0.1.0"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.6-r.1"
  },
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 104",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ]
}
